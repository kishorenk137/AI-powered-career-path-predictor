import React, { useState } from 'react';
import { AuthProvider } from './context/AuthContext';
import { ThemeProvider } from './context/ThemeContext';
import { Header } from './components/common/Header';
import { AuthModal } from './components/common/AuthModal';
import { LandingPage } from './components/landing/LandingPage';
import { AssessmentWizard } from './components/assessment/AssessmentWizard';
import { AIProcessingScreen } from './components/assessment/AIProcessingScreen';
import { Dashboard } from './components/dashboard/Dashboard';
import { CareerDetail } from './components/career/CareerDetail';
import { SkillGapView } from './components/skills/SkillGapView';
import { RoadmapView } from './components/roadmap/RoadmapView';
import { ProjectRecommendationsView } from './components/projects/ProjectRecommendationsView';
import { CareerExplorer } from './components/career/CareerExplorer';
import { CareerComparison } from './components/career/CareerComparison';
import { AdminDashboard } from './components/admin/AdminDashboard';
import { AIAssistantDrawer } from './components/assistant/AIAssistantDrawer';
function MainApp() {
  const [currentView, setCurrentView] = useState<string>('landing');
  const [selectedCareerId, setSelectedCareerId] = useState<string>('software-engineer');
  const [isAuthOpen, setIsAuthOpen] = useState(false);
  const [isProcessing, setIsProcessing] = useState(false);
  const navigateTo = (view: string) => {
    setCurrentView(view);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
  const handleSelectCareer = (careerId: string) => {
    setSelectedCareerId(careerId);
    setCurrentView('career-detail');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
  const handleProcessingFinish = () => {
    setIsProcessing(false);
    setCurrentView('dashboard');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
  return (
    <div className="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300">
      <Header
        currentView={currentView}
        onNavigate={navigateTo}
        onOpenAuth={() => setIsAuthOpen(true)}
      />
      <main className="flex-1">
        {isProcessing ? (
          <AIProcessingScreen onFinish={handleProcessingFinish} />
        ) : (
          <>
            {currentView === 'landing' && (
              <LandingPage
                onStartAssessment={() => navigateTo('assessment')}
                onExploreCareers={() => navigateTo('explorer')}
                onOpenDashboard={() => navigateTo('dashboard')}
              />
            )}
            {currentView === 'assessment' && (
              <AssessmentWizard
                onComplete={() => navigateTo('dashboard')}
                onStartAnalysis={() => setIsProcessing(true)}
              />
            )}
            {currentView === 'dashboard' && (
              <Dashboard
                onSelectCareer={handleSelectCareer}
                onNavigate={navigateTo}
              />
            )}
            {currentView === 'career-detail' && (
              <CareerDetail
                careerId={selectedCareerId}
                onBack={() => navigateTo('dashboard')}
                onNavigate={navigateTo}
              />
            )}
            {currentView === 'skillgap' && (
              <SkillGapView
                onSelectCareer={handleSelectCareer}
                onNavigate={navigateTo}
              />
            )}
            {currentView === 'roadmap' && (
              <RoadmapView
                onSelectCareer={handleSelectCareer}
                onNavigate={navigateTo}
              />
            )}
            {currentView === 'projects' && (
              <ProjectRecommendationsView
                onSelectCareer={handleSelectCareer}
                onNavigate={navigateTo}
              />
            )}
            {currentView === 'explorer' && (
              <CareerExplorer onSelectCareer={handleSelectCareer} />
            )}
            {currentView === 'compare' && (
              <CareerComparison onSelectCareer={handleSelectCareer} />
            )}
            {currentView === 'admin' && <AdminDashboard />}
          </>
        )}
      </main>
      <AIAssistantDrawer currentCareerId={selectedCareerId} />
      <AuthModal isOpen={isAuthOpen} onClose={() => setIsAuthOpen(false)} />
    </div>
  );
}
export default function App() {
  return (
    <ThemeProvider>
      <AuthProvider>
        <MainApp />
      </AuthProvider>
    </ThemeProvider>
  );
}
