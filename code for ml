export function generateExplainability(career, assessment, scoreResult) {
  const { breakdown, matchScore } = scoreResult;
  const { skills = [], interests = [], projectsAndExperience = {}, academicProfile = {} } = assessment || {};
  const drivers = [];
  if (breakdown.skills >= 80) {
    const strongSkills = skills.filter(s => s.proficiency >= 75).map(s => s.name).slice(0, 3);
    drivers.push(`High proficiency in key required skills (${strongSkills.join(', ') || 'core domains'})`);
  }
  if (breakdown.interests >= 75) {
    drivers.push(`Strong overlap with your expressed interest in ${interests.slice(0, 2).join(' and ')}`);
  }
  if (breakdown.academic >= 80) {
    drivers.push(`Direct academic coursework alignment in ${academicProfile.degree || 'Computer Science'}`);
  }
  if (breakdown.projects >= 75) {
    const count = (projectsAndExperience.projects || []).length;
    drivers.push(`Relevant practical experience across ${count} documented projects and internships`);
  }
  if (breakdown.preferences >= 80) {
    drivers.push(`Close harmony with your preferred work style, problem-solving depth, and collaboration tempo`);
  }
  let narrative = '';
  if (matchScore >= 88) {
    narrative = `Your technical foundation, hands-on project portfolio, and stated interest in ${interests[0] || 'technology'} make ${career.title} an exceptional match for your trajectory. Your highest compatibility indicators are in Skills (${breakdown.skills}%) and Work Preferences (${breakdown.preferences}%).`;
  } else if (matchScore >= 75) {
    narrative = `${career.title} aligns well with your academic profile and problem-solving strengths. Bridging a few specialized technical skills will rapidly elevate your job readiness to top-tier status.`;
  } else {
    narrative = `${career.title} offers an alternative growth path. While your general analytical skills translate well, focused upskilling across core domain requirements is recommended.`;
  }
  const factorAttributions = [
    { factor: 'Skills Match', weight: '40%', score: breakdown.skills, impact: breakdown.skills >= 80 ? 'High Positive' : 'Growth Area' },
    { factor: 'Interest Match', weight: '25%', score: breakdown.interests, impact: breakdown.interests >= 75 ? 'High Positive' : 'Moderate' },
    { factor: 'Academic Match', weight: '15%', score: breakdown.academic, impact: breakdown.academic >= 80 ? 'High Positive' : 'Moderate' },
    { factor: 'Project Match', weight: '10%', score: breakdown.projects, impact: breakdown.projects >= 70 ? 'High Positive' : 'Moderate' },
    { factor: 'Work Preferences', weight: '10%', score: breakdown.preferences, impact: breakdown.preferences >= 75 ? 'High Positive' : 'Moderate' }
  ];
  return {
    narrative,
    primaryDrivers: drivers,
    factorAttributions,
    transparencyNote: "Recommendations are computed deterministically through multi-factor weighted matching."
  };
}
