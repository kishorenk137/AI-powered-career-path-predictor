import { RECOMMENDATION_WEIGHTS } from '../config/weights.js';
export function calculateCareerMatch(career, assessment) {
  if (!assessment) {
    return {
      careerId: career.id,
      title: career.title,
      category: career.category,
      matchScore: 0,
      breakdown: { skills: 0, interests: 0, academic: 0, projects: 0, preferences: 0 }
    };
  }
  const {
    academicProfile = {},
    skills = [],
    interests = [],
    projectsAndExperience = {},
    workPreferences = {}
  } = assessment;
  // 1. SKILLS MATCH (40% weight)
  const userSkillMap = new Map();
  skills.forEach(s => {
    userSkillMap.set(s.name.toLowerCase().trim(), Number(s.proficiency) || 0);
  });
  const careerSkills = career.matchCriteria?.skills || [];
  let skillScoreSum = 0;
  let totalSkillWeight = 0;
  careerSkills.forEach(reqSkill => {
    const skillName = reqSkill.name.toLowerCase().trim();
    const userProficiency = userSkillMap.get(skillName) || 0;
    const requiredLevel = reqSkill.requiredLevel || 70;
    let weight = 1.0;
    if (reqSkill.importance === 'critical') weight = 1.5;
    if (reqSkill.importance === 'nice_to_have') weight = 0.6;
    const ratio = Math.min(userProficiency / requiredLevel, 1.15);
    skillScoreSum += (ratio * 100) * weight;
    totalSkillWeight += weight;
  });
  const skillsMatch = totalSkillWeight > 0
    ? Math.min(100, Math.round(skillScoreSum / totalSkillWeight))
    : 50;
  // 2. INTEREST MATCH (25% weight)
  const careerInterests = (career.matchCriteria?.interests || []).map(i => i.toLowerCase().trim());
  const userInterests = (interests || []).map(i => i.toLowerCase().trim());
  let matchedInterests = 0;
  careerInterests.forEach(ci => {
    if (userInterests.some(ui => ui.includes(ci) || ci.includes(ui))) {
      matchedInterests++;
    }
  });
  const interestsMatch = careerInterests.length > 0
    ? Math.min(100, Math.round((matchedInterests / careerInterests.length) * 100))
    : 50;
  // 3. ACADEMIC MATCH (15% weight)
  let academicScore = 60;
  const relevantDegrees = (career.matchCriteria?.relevantDegrees || []).map(d => d.toLowerCase());
  const userDegree = (academicProfile.degree || "").toLowerCase();
  const userSpec = (academicProfile.specialization || "").toLowerCase();
  if (relevantDegrees.some(rd => userDegree.includes(rd) || userSpec.includes(rd))) {
    academicScore += 20;
  }
  const cgpa = Number(academicProfile.cgpa) || 7.0;
  if (cgpa >= 8.5) academicScore += 10;
  else if (cgpa >= 7.5) academicScore += 5;
  const relevantSubjects = (career.matchCriteria?.relevantSubjects || []).map(s => s.toLowerCase());
  const userSubjects = [
    ...(academicProfile.favoriteSubjects || []),
    ...(academicProfile.strongSubjects || [])
  ].map(s => s.toLowerCase());
  const subjectMatches = relevantSubjects.filter(rs =>
    userSubjects.some(us => us.includes(rs) || rs.includes(us))
  ).length;
  academicScore += Math.min(10, subjectMatches * 3);
  const academicMatch = Math.min(100, Math.max(30, academicScore));
  // 4. PROJECT MATCH (10% weight)
  const userProjects = projectsAndExperience.projects || [];
  const careerProjectCats = (career.matchCriteria?.projectCategories || []).map(c => c.toLowerCase());
  let projectScore = 40;
  if (userProjects.length > 0) {
    projectScore += Math.min(30, userProjects.length * 10);
    userProjects.forEach(p => {
      const cat = (p.category || "").toLowerCase();
      const techs = (p.technologies || []).map(t => t.toLowerCase());
      if (careerProjectCats.some(cpc => cat.includes(cpc) || cpc.includes(cat))) {
        projectScore += 15;
      }
      if (careerSkills.some(cs => techs.some(t => t.includes(cs.name.toLowerCase())))) {
        projectScore += 10;
      }
    });
  }
  if (projectsAndExperience.internshipExperience) projectScore += 10;
  if ((projectsAndExperience.certifications || []).length > 0) projectScore += 5;
  if ((projectsAndExperience.hackathons || 0) > 0) projectScore += 5;
  const projectMatch = Math.min(100, Math.max(20, projectScore));
  // 5. WORK PREFERENCE MATCH (10% weight)
  const careerPrefs = career.matchCriteria?.preferenceAlignment || {
    peopleVsTech: 50,
    problemSolving: 75,
    creativeVsStructured: 50,
    dataVsBuilding: 50,
    teamOrientation: 65
  };
  const prefKeys = ['peopleVsTech', 'problemSolving', 'creativeVsStructured', 'dataVsBuilding', 'teamOrientation'];
  let prefDistance = 0;
  prefKeys.forEach(key => {
    const userVal = Number(workPreferences[key]) || 50;
    const careerVal = Number(careerPrefs[key]) || 50;
    prefDistance += Math.abs(userVal - careerVal);
  });
  const avgDiff = prefDistance / prefKeys.length;
  const workPreferenceMatch = Math.max(35, Math.round(100 - (avgDiff * 0.75)));
  // FINAL FORMULA
  const finalScore = Math.round(
    (skillsMatch * RECOMMENDATION_WEIGHTS.SKILLS) +
    (interestsMatch * RECOMMENDATION_WEIGHTS.INTERESTS) +
    (academicMatch * RECOMMENDATION_WEIGHTS.ACADEMIC) +
    (projectMatch * RECOMMENDATION_WEIGHTS.PROJECTS) +
    (workPreferenceMatch * RECOMMENDATION_WEIGHTS.WORK_PREFERENCES)
  );
  return {
    careerId: career.id,
    title: career.title,
    category: career.category,
    icon: career.icon,
    badge: career.badge,
    description: career.description,
    avgSalaryRange: career.avgSalaryRange,
    difficulty: career.difficulty,
    matchScore: Math.min(99, Math.max(35, finalScore)),
    breakdown: {
      skills: skillsMatch,
      interests: interestsMatch,
      academic: academicMatch,
      projects: projectMatch,
      preferences: workPreferenceMatch
    },
    weights: RECOMMENDATION_WEIGHTS
  };
}
export function rankCareers(allCareers, assessment) {
  const scored = allCareers.map(career => calculateCareerMatch(career, assessment));
  scored.sort((a, b) => b.matchScore - a.matchScore);
  return scored;
}
