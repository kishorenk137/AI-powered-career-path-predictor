import {
  User,
  Assessment,
  Career,
  CareerMatch,
  ExplainabilityData,
  SkillGapData,
  NextLearningStepsData,
  RecommendedProject
} from '../types';
const BASE_URL = '/api';
async function request<T>(endpoint: string, options?: RequestInit): Promise<T> {
  const res = await fetch(`${BASE_URL}${endpoint}`, {
    headers: { 'Content-Type': 'application/json', ...options?.headers },
    ...options
  });
  const json = await res.json();
  if (!res.ok || json.success === false) {
    throw new Error(json.error || `HTTP error ${res.status}`);
  }
  return json.data !== undefined ? json.data : json;
}
export const authApi = {
  getDemoUsers: () => request<User[]>('/auth/demo-users'),
  switchDemo: (id: string) => request<User>(`/auth/switch-demo/${id}`, { method: 'POST' }),
  login: (email: string) => request<User>('/auth/login', { method: 'POST', body: JSON.stringify({ email }) }),
  register: (name: string, email: string, headline?: string) =>
    request<User>('/auth/register', { method: 'POST', body: JSON.stringify({ name, email, headline }) })
};
export const assessmentApi = {
  getAssessment: (userId: string) => request<Assessment | null>(`/assessment/${userId}`),
  saveAssessment: (userId: string, data: Assessment) =>
    request<{ rankedCareers: CareerMatch[]; topCareer: CareerMatch }>(`/assessment/${userId}`, {
      method: 'POST',
      body: JSON.stringify(data)
    })
};
export const careersApi = {
  getCareers: (params?: { category?: string; search?: string; userId?: string }) => {
    const query = new URLSearchParams();
    if (params?.category) query.append('category', params.category);
    if (params?.search) query.append('search', params.search);
    if (params?.userId) query.append('userId', params.userId);
    return request<Career[]>(`/careers?${query.toString()}`);
  },
  getCareer: (id: string, userId?: string) => {
    const query = userId ? `?userId=${userId}` : '';
    return request<Career>(`/careers/${id}${query}`);
  },
  compareCareers: (careerIds: string[], userId?: string) =>
    request<{ careers: any[]; radarMetrics: any[] }>('/careers/compare', {
      method: 'POST',
      body: JSON.stringify({ careerIds, userId })
    })
};
export const recommendationsApi = {
  getRecommendations: (userId: string) =>
    request<{
      rankedCareers: CareerMatch[];
      topCareer: CareerMatch;
      explainability: ExplainabilityData | null;
      skillGap: SkillGapData | null;
      nextSteps: NextLearningStepsData | null;
    }>(`/recommendations/${userId}`),
  getDeepDive: (careerId: string, userId: string) =>
    request<{
      career: Career;
      scoreResult: CareerMatch;
      explainability: ExplainabilityData;
      skillGap: SkillGapData;
      nextSteps: NextLearningStepsData;
      projects: { careerId: string; careerTitle: string; projects: RecommendedProject[] };
    }>(`/recommendations/career/${careerId}/deepdive/${userId}`)
};
